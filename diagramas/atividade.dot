digraph G {
  graph [fontname="Arial", bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.65", labelloc="t", fontsize="20"];
  node [fontname="Arial", fontsize="13", color="#265677", penwidth="1.4"];
  edge [fontname="Arial", fontsize="11", color="#34495e"];
  rankdir=TB;
  label="Atividade proposta — acesso e solicitação de evento";
  node [shape=box, style="rounded,filled", fillcolor="#eef7fc"];
  start [shape=circle, label="", width=.2, height=.2, fillcolor="#244e67"];
  a [label="Abrir Organizador e informar\ne-mail institucional"];
  b [label="Frontend solicita link de acesso"];
  decision [shape=diamond, label="Resposta da\nsolicitação?", style=filled, fillcolor="#fff7e5"];
  dry [label="Modo de teste: interface informa\nque nenhum e-mail foi enviado"];
  err [label="Falha ou acesso não concluído"];
  waitmail [label="Aguardar recebimento do e-mail\n(etapa proposta; não verificada)"];
  received [shape=diamond, label="Link recebido?", style=filled, fillcolor="#fff7e5"];
  openlink [label="Abrir o link recebido\n(etapa proposta; não verificada)"];
  callback [label="Callback de autenticação\n(caminho proposto; não verificado)"];
  auth [shape=diamond, label="Sessão validada?", style=filled, fillcolor="#fff7e5"];
  event [label="Preencher tipo e dados do evento\n(conforme rotas do frontend)"];
  schedule [label="Consultar salas/horários e revisar dados"];
  draft [label="Salvar rascunho (requisição)"];
  send [label="Enviar para aprovação (requisição)"];
  end [shape=doublecircle, label="", width=.2, height=.2, fillcolor="#244e67"];
  note [shape=note, fillcolor="#fff7e5", label="Fluxo sintético: recebimento, abertura do link,\nvalidação e sequência do evento são hipóteses.\nNenhum login ou execução no backend foi verificado."];
  start -> a -> b -> decision;
  decision -> dry [label="teste"];
  decision -> err [label="falha"];
  decision -> waitmail [label="solicitação aceita"];
  waitmail -> received;
  received -> openlink [label="sim"];
  received -> err [label="não recebido"];
  openlink -> callback -> auth;
  auth -> event [label="sim"];
  auth -> err [label="não / falha", style=dashed];
  event -> schedule;
  schedule -> draft [label="opcional"];
  schedule -> send;
  draft -> send [style=dashed];
  draft -> end [label="encerrar"];
  send -> end;
  dry -> end;
  err -> end;
}
