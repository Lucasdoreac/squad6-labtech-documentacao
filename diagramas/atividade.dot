digraph G { graph [fontname="Arial", bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.65", labelloc="t", fontsize="20"]; node [fontname="Arial", fontsize="13", color="#265677", penwidth="1.4"]; edge [fontname="Arial", fontsize="11", color="#34495e"]; rankdir=TB; label="Atividade — acesso e solicitação de evento"; node [shape=box,style="rounded,filled",fillcolor="#eef7fc"]; start[shape=circle,label="",width=.2,height=.2,fillcolor="#244e67"]; a[label="Abrir Organizador e informar\ne-mail institucional"]; b[label="Frontend solicita link de acesso"]; decision[shape=diamond,label="Resposta\nda solicitação?",style=filled,fillcolor="#fff7e5"]; dry[label="Modo de teste: interface informa\nque nenhum e-mail foi enviado"]; err[label="Interface apresenta mensagem de erro"]; callback[label="Seguir para callback de autenticação\n(quando indicado pelo cliente)"]; auth[shape=diamond,label="Sessão validada?",style=filled,fillcolor="#fff7e5"]; event[label="Preencher tipo e dados do evento\n(conforme rotas do frontend)"]; schedule[label="Consultar salas/horários e revisar dados"]; draft[label="Salvar rascunho (requisição)"]; send[label="Enviar para aprovação (requisição)"]; end[shape=doublecircle,label="",width=.2,height=.2,fillcolor="#244e67"]; note[shape=note,fillcolor="#fff7e5",label="Fluxo sintético baseado no código público.\nOrdem das etapas de evento é inferida;\nrespostas e execução no backend não testadas."]; start->a->b->decision; decision->dry[label="teste"]; decision->err[label="falha"]; decision->callback[label="sucesso indicado"]; callback->auth; auth->event[label="sim"]; auth->err[label="não / falha",style=dashed]; event->schedule; schedule->draft [label="opcional"]; schedule->send; draft->send [style=dashed]; draft->end [label="encerrar"]; send->end; dry->end; err->end; }