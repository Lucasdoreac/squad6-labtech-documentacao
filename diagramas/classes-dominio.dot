digraph G { graph [fontname="Arial", bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.65", labelloc="t", fontsize="20"]; node [fontname="Arial", fontsize="13", color="#265677", penwidth="1.4"]; edge [fontname="Arial", fontsize="11", color="#34495e"]; rankdir=LR; label="Modelo conceitual — dados referenciados pelo frontend"; node [shape=record,style=filled,fillcolor="#f2f8fc"]; O[label="{Organizador|email\ntelefone}"]; E[label="{Evento|name\ndescription\neventTypeId\nexpectedSubscribers\ntargetPublic}"]; T[label="{Tipo de evento|id}"]; C[label="{Curso|id\nname}"]; S[label="{Sala / espaço|roomType\nroom_name}"]; R[label="{Consulta de disponibilidade|date\ntime\npage\npage_size}"]; O->E [dir=none,label="organiza (inferido)",style=dashed]; E->T [dir=none,style=dashed,label="classificação (inferida)"]; E->C [dir=none,style=dashed,label="curso (inferido)"]; E->S [dir=none,style=dashed,label="espaço solicitado (inferido)"]; R->S [dir=none,style=dashed,label="consulta (inferida)"]; n[shape=note,fillcolor="#fff7e5",label="Classes e relações conceituais, não esquema de banco.\nTracejado = relação inferida; multiplicidades não verificadas.\nCampos: nomes do código ou rótulos da interface."]; }